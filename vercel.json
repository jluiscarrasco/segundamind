{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://us-central1-secondbrain-765b9.cloudfunctions.net/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
      ]
    }
  ]
}
